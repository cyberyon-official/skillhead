{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/skillhead\" slot env"},
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/skillhead\" refuse_hook_bypass"},
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/skillhead\" builder_no_tests"},
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/skillhead\" guard_issue_create"}
        ]
      },
      {
        "matcher": "mcp__.*create_issue",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/skillhead\" guard_issue_create"}
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/skillhead\" loop_running"}
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {"type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/bin/skillhead\" spawn_guard"}
        ]
      }
    ]
  }
}
